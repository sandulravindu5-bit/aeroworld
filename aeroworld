function createAircraftCard(plane) {
  const card = document.createElement("article");
  card.className = "card";

  const media = document.createElement("div");
  const image = document.createElement("img");
  image.className = "aircraft-image";
  image.alt = plane.name;
  image.loading = "lazy";
  image.referrerPolicy = "no-referrer";

  const fallback = document.createElement("div");
  fallback.className = "image-fallback";
  fallback.textContent = "✈️";
  fallback.hidden = true;

  media.append(image, fallback);
  card.appendChild(media);

  const content = document.createElement("div");
  content.className = "card-content";

  const tag = document.createElement("span");
  tag.className = "tag";
  tag.textContent = plane.category;

  const title = document.createElement("h3");
  title.textContent = plane.name;

  const maker = document.createElement("p");
  maker.className = "small";
  maker.textContent = plane.maker + " · First flight: " + plane.year;

  const description = document.createElement("p");
  description.textContent = plane.description;

  const actions = document.createElement("div");
  actions.className = "card-actions";

  const favorite = document.createElement("button");
  function updateFavoriteLabel() {
    favorite.textContent = favorites.has(plane.name) ? "★ Saved" : "☆ Favorite";
  }
  updateFavoriteLabel();

  favorite.addEventListener("click", () => {
    if (favorites.has(plane.name)) favorites.delete(plane.name);
    else favorites.add(plane.name);
    saveFavorites();
    updateFavoriteLabel();
    renderAircraft();
  });

  const wiki = document.createElement("a");
  wiki.className = "btn";
  wiki.href = "https://en.wikipedia.org/wiki/" + encodeURIComponent(plane.wiki);
  wiki.target = "_blank";
  wiki.rel = "noopener noreferrer";
  wiki.textContent = "Read more ↗";

  actions.append(favorite, wiki);
  content.append(tag, title, maker, description, actions);
  card.appendChild(content);

  image.addEventListener("error", () => {
    image.hidden = true;
    fallback.hidden = false;
  });

  loadAircraftImage(plane, image);

  return card;
}

async function loadAircraftImage(plane, image) {
  if (imageCache.has(plane.wiki)) {
    const cached = imageCache.get(plane.wiki);
    if (cached) image.src = cached;
    else {
      image.hidden = true;
      image.nextElementSibling.hidden = false;
    }
    return;
  }

  try {
    const endpoint = "https://en.wikipedia.org/api/rest_v1/page/summary/" +
      encodeURIComponent(plane.wiki);
    const response = await fetch(endpoint);
    if (!response.ok) throw new Error("Image unavailable");

    const data = await response.json();
    const source = data.thumbnail && data.thumbnail.source;

    imageCache.set(plane.wiki, source || null);

    if (source) image.src = source;
    else {
      image.hidden = true;
      image.nextElementSibling.hidden = false;
    }
  } catch (error) {
    imageCache.set(plane.wiki, null);
    image.hidden = true;
    image.nextElementSibling.hidden = false;
  }
}

function renderAircraft() {
  const query = searchInput.value.trim().toLowerCase();
  const category = categoryFilter.value;
  const matches = aircraft.filter(plane => {
    const matchesSearch =
      (plane.name + " " + plane.maker + " " + plane.description)
        .toLowerCase().includes(query);
    const matchesCategory = category === "All" || plane.category === category;
    const matchesFavorite = !onlyFavorites || favorites.has(plane.name);
    return matchesSearch && matchesCategory && matchesFavorite;
  });

  grid.replaceChildren();
  matches.forEach(plane => grid.appendChild(createAircraftCard(plane)));

  document.getElementById("resultsCount").textContent =
    "Showing " + matches.length + " of " + aircraft.length + " aircraft.";
  favoritesButton.textContent = onlyFavorites ? "★ Show all aircraft" : "☆ Favorites only";
}

searchInput.addEventListener("input", renderAircraft);
