<style>
:root {
  --bg:#071426;
  --panel:#10233c;
  --panel2:#162d49;
  --text:#edf5ff;
  --muted:#a9bdd4;
  --accent:#36c5f0;
  --accent2:#6f8cff;
  --border:#29415e;
}
body.light {
  --bg:#eef4fa;
  --panel:#ffffff;
  --panel2:#e4edf7;
  --text:#15283d;
  --muted:#52677e;
  --accent:#007eae;
  --accent2:#405ad6;
  --border:#c8d6e5;
}
* {box-sizing:border-box}
html {scroll-behavior:smooth;scroll-padding-top:90px}
body {
  margin:0;background:var(--bg);color:var(--text);
  font-family:Arial,Helvetica,sans-serif;line-height:1.65;
  transition:background .25s,color .25s
}
button,input,select {font:inherit}
button {cursor:pointer}
a {color:var(--accent);text-decoration:none}
a:hover {text-decoration:underline}
header {
  position:sticky;top:0;z-index:100;
  background:var(--panel);border-bottom:1px solid var(--border)
}
.nav {
  max-width:1250px;margin:auto;padding:12px 20px;
  display:flex;align-items:center;justify-content:space-between;gap:18px
}
.brand {font-size:1.35rem;font-weight:900;white-space:nowrap}
.brand span {color:var(--accent)}
nav {display:flex;gap:15px;flex-wrap:wrap;align-items:center}
nav a {color:var(--text);font-size:.9rem}
button,.btn {
  border:1px solid var(--border);border-radius:9px;
  padding:9px 13px;background:var(--panel2);color:var(--text)
}
button:hover,.btn:hover {border-color:var(--accent)}
button:disabled {opacity:.4;cursor:not-allowed}
.primary {background:var(--accent);color:#041321;font-weight:bold;border:0}
.container {max-width:1250px;margin:auto;padding:28px 20px}
.hero {
  padding:65px 24px;border:1px solid var(--border);border-radius:22px;
  background:radial-gradient(ellipse at 80% 10%,#17638a 0%,transparent 45%),
  linear-gradient(135deg,#071426,#132c4a);
  color:#fff;overflow:hidden
}
.hero h1 {font-size:clamp(2.3rem,6vw,4.6rem);line-height:1.08;margin:12px 0}
.hero p {max-width:720px;color:#d4e5f7;font-size:1.1rem}
.eyebrow {color:#67defb;font-weight:bold;letter-spacing:2px;text-transform:uppercase}
.hero-actions {display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}
.hero .btn {background:#eaf8ff;color:#0a2339;border:0;font-weight:bold}
.stats {
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;margin-top:18px
}
.stat {background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px}
.stat strong {font-size:1.5rem;color:var(--accent);display:block}
.section {margin-top:58px}
.section-heading {margin-bottom:20px}
.section-heading h2 {font-size:clamp(1.6rem,4vw,2.3rem);margin:0 0 5px}
.section-heading p,.muted,.small {color:var(--muted)}
.small {font-size:.85rem}
.controls {display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}
input,select {
  background:var(--panel);color:var(--text);
  border:1px solid var(--border);border-radius:9px;padding:11px
}
input {flex:1;min-width:180px}
.grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
.card {
  background:var(--panel);border:1px solid var(--border);
  border-radius:15px;overflow:hidden;min-width:0
}
.card-content {padding:16px}
.card h3 {margin:0 0 7px}
.aircraft-image {
  width:100%;height:185px;object-fit:cover;display:block;background:var(--panel2)
}
.image-fallback {
  height:185px;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,var(--panel2),var(--bg));
  font-size:3.5rem
}
.tag {
  display:inline-block;background:var(--panel2);color:var(--accent);
  border-radius:20px;padding:4px 10px;font-size:.78rem;margin-bottom:9px
}
.card-actions {display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.card-actions button {font-size:.85rem}
.theory-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.theory-card {
  background:var(--panel);border:1px solid var(--border);
  border-radius:14px;padding:19px
}
.theory-card h3 {margin-top:0}
.theory-card p {color:var(--muted)}
.note {
  background:var(--panel2);border-left:4px solid var(--accent);
  border-radius:8px;padding:17px;margin-top:17px
}
.split {display:grid;grid-template-columns:1fr 1fr;gap:18px}
.instrument-display {
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;
  margin-top:18px
}
.gauge {
  min-height:130px;display:flex;flex-direction:column;justify-content:center;
  align-items:center;text-align:center;border:2px solid #8298ae;
  border-radius:50%;aspect-ratio:1;background:#0c1929;color:#fff;padding:8px
}
.gauge .symbol {font-size:2rem}
.gauge strong {font-size:.9rem}
.gauge span {font-size:.75rem;color:#bcd0e5}
.quiz-option {
  display:block;width:100%;text-align:left;margin:9px 0;
  border:1px solid var(--border);background:var(--panel2);
  padding:12px;border-radius:9px;color:var(--text)
}
.quiz-option.correct {border-color:#32bd84;background:#14533e}
.quiz-option.wrong {border-color:#f47e7e;background:#622b35}
#quizFeedback {margin-top:12px}
footer {
  border-top:1px solid var(--border);text-align:center;
  padding:28px 18px;color:var(--muted);margin-top:50px
}
[hidden] {display:none!important}
@media(max-width:900px) {
  .grid,.theory-grid {grid-template-columns:repeat(2,minmax(0,1fr))}
  .nav {align-items:flex-start;flex-direction:column}
  nav {gap:12px}
}
@media(max-width:600px) {
  .grid,.theory-grid,.split {grid-template-columns:1fr}
  .stats {grid-template-columns:repeat(2,minmax(0,1fr))}
  .instrument-display {grid-template-columns:repeat(2,minmax(0,1fr))}
  .hero {padding:38px 20px}
  .container {padding:20px 14px}
}
</style>
